# Copie ce fichier en `.env` et remplis les valeurs.
# Le `.env` est ignoré par git — il ne doit JAMAIS être commité.

# --- Telegram (Sprint 3) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Scraping ---
INTERVAL_MINUTES=60
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36
POSTAL_CODE=M6N 5G8
REQUEST_DELAY_MIN=1
REQUEST_DELAY_MAX=3

# --- Alerting (Sprint 2) ---
BUDGET=2000                   # budget cible HT : badge 🔴 + ligne « 🎯 Budget »
PRICE_ERROR_PCT=40            # baisse ≥ 40 % = erreur de prix probable → alerte 🚨
STOCK_CHECK_ENABLED=true      # alerte 🔵 quand un produit de la watchlist revient en stock
TAX_RATE=0.13
REALERT_DELTA=50
DAILY_REMINDER=true
FAILURE_THRESHOLD=3

# --- Discovery (Sprint 6 / 8) ---
DISCOVERY_ENABLED=true
DISCOVERY_MAX_PRICE=2000
DISCOVERY_MIN_PRICE=900
DISCOVERY_MIN_DISCOUNT_PCT=15       # requis seulement au-dessus du BUDGET
DISCOVERY_APPLE_SILICON_ONLY=true
DISCOVERY_INCLUDE_REFURBISHED=true
DISCOVERY_MIN_CHIP=4                # M4 …
DISCOVERY_MAX_CHIP=6                # … à M6
MIN_RAM_GB=16
MIN_STORAGE_GB=512
ALLOW_UNKNOWN_SPECS=true            # specs illisibles : signalé avec « ⚠️ à vérifier »
DISCOVERY_QUERIES=macbook pro       # plusieurs requêtes : séparées par des virgules
DISCOVERY_MAX_PAGES=15              # 24 résultats/page
DISCOVERY_MAX_ALERTS_PER_CYCLE=5    # au-delà : 1 message récapitulatif
DEFAULT_MIN_DISCOUNT_PCT=15

# --- Mode Black Friday (F13) ---
RUSH_ENABLED=true
RUSH_START=11-20                    # MM-JJ inclus, heure de Toronto
RUSH_END=12-02
RUSH_INTERVAL_MINUTES=10
