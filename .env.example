# Copie ce fichier en `.env` et remplis les valeurs.
# Le `.env` est ignoré par git — il ne doit JAMAIS être commité.

# --- Telegram (Sprint 3) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Scraping ---
INTERVAL_MINUTES=60
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36
POSTAL_CODE=M6N 5G8
REQUEST_DELAY_MIN=1
REQUEST_DELAY_MAX=3

# --- Alerting (Sprint 2) ---
TAX_RATE=0.13
REALERT_DELTA=50
DAILY_REMINDER=true
FAILURE_THRESHOLD=3

# --- Discovery (Sprint 6) ---
DISCOVERY_ENABLED=true
DISCOVERY_MAX_PRICE=2000
DISCOVERY_MIN_PRICE=1200
DISCOVERY_MIN_DISCOUNT_PCT=15
DISCOVERY_APPLE_SILICON_ONLY=true
DISCOVERY_INCLUDE_REFURBISHED=false
DEFAULT_MIN_DISCOUNT_PCT=15
